# Base URL of the CodeBazaar API. The only env var this frontend reads.
# NEXT_PUBLIC_* values are inlined at build time, so changing this in a hosted
# environment (Vercel) requires a redeploy, not just a restart.
#
# Local Docker: http://localhost:8000
# Hosted: https://<your-api>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
